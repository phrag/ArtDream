<?xml version="1.0" encoding="UTF-8"?>
<!--
  Checksums for the only dependencies fetched from JitPack. JitPack builds from git tags, which can
  be moved, so a changed artifact must fail the build instead of being picked up quietly.
  Everything else (Maven Central, Google) is trusted as before, hence the trust rule below.
  To update NewPipeExtractor: change the version, run Gradle once with its
  write-verification-metadata option set to sha256 (see the Gradle docs), and keep only the
  com.github components from the result.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!com\.github\.).*" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
